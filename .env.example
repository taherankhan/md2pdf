# Google Analytics 4 — Measurement ID from GA4 Admin (format G-XXXXXXXXXX)
# Leave empty to disable tracking in local dev
GA_MEASUREMENT_ID=

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secret key for user session signing (min 32 characters)
JWT_SECRET=md2pdfx-secret-jwt-key-2026-secure-auth-token-salt

# MongoDB Atlas — required for cloud share links, user library, and contact form
# Atlas Dashboard → Database → Connect → Drivers (Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/md2pdf?retryWrites=true&w=majority
MONGODB_DB_NAME=md2pdf

# Port for local Express backend
PORT=3026

# Optional: Base URL for API (leave blank for same-origin / local dev proxy / Vercel rewrites)
VITE_API_BASE_URL=
